# Load with: set -a; source .env; set +a
# Credentials remain in ~/.aws/credentials, not this file.
AWS_PROFILE=mb-learnerlab
TF_VAR_region=us-east-1
TF_VAR_lab_account_id=702238036392
TF_VAR_project_prefix=churn-rebuild
TF_VAR_raw_s3_uri=s3://aai-540-group-2/raw/cell2cell/
TF_VAR_output_bucket=customer-churn-pipeline-a81b79
TF_VAR_curated_version=v1

# Stages 2 and 3. Existing Learner Lab bucket; Terraform does not create it.
TF_VAR_offline_store_bucket=sagemaker-us-east-1-702238036392
TF_VAR_feature_version=v1
TF_VAR_preprocessing_contract=v1
TF_VAR_model_version=v1
TF_VAR_execution_role_name=LabRole
TF_VAR_xgboost_image=683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-xgboost:1.7-1
TF_VAR_instance_type=ml.m5.xlarge
TF_VAR_auc_threshold=0.60
